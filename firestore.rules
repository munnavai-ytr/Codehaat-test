rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isPermanent() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(uid) {
      return isPermanent() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isPermanent()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSeller() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['seller', 'admin'];
    }

    function isReserved(name) {
      return name in [
        'admin', 'administrator', 'root', 'support', 'help', 'codehaat', 'dealwave',
        'api', 'login', 'signin', 'signup', 'register', 'explore', 'feed', 'saved',
        'briefs', 'messages', 'dashboard', 'settings', 'deal', 'terms', 'privacy',
        'mod', 'moderator', 'system', 'official', 'bot', 'billing', 'auth'
      ];
    }

    match /admins/{adminUid} {
      allow get: if isOwner(adminUid);
      allow list, write: if false;
    }

    match /usernames/{usernameLower} {
      allow get: if true;
      allow list: if false;

      allow create: if isPermanent()
        && usernameLower.matches('^[a-z0-9_]{3,24}$')
        && !isReserved(usernameLower)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'claimedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.lower() == usernameLower;

      allow update: if isPermanent()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'username', 'claimedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == resource.data.username;

      allow delete: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    function userKeysOk() {
      return request.resource.data.keys().hasOnly([
        'uid', 'displayName', 'username', 'usernameLower', 'photoURL',
        'bio', 'role', 'locale', 'isAnonymous', 'sellerProfile',
        'createdAt', 'updatedAt'
      ]);
    }

    function userValuesOk() {
      let d = request.resource.data;
      return d.uid is string
        && d.displayName is string && d.displayName.size() <= 80
        && d.get('bio', '') is string && d.get('bio', '').size() <= 500
        && d.get('locale', 'en') in ['en', 'bn']
        && d.get('isAnonymous', false) == false
        && (d.get('photoURL', null) == null || d.get('photoURL', null) is string);
    }

    function sellerProfileOk() {
      let sp = request.resource.data.get('sellerProfile', null);
      return sp == null
        || (sp is map
            && sp.brandName is string && sp.brandName.size() <= 60
            && sp.headline is string && sp.headline.size() <= 120
            && sp.bio is string && sp.bio.size() <= 1000);
    }

    function usernameClaimedAfter() {
      let d = request.resource.data;
      return !('usernameLower' in d)
        || (existsAfter(/databases/$(database)/documents/usernames/$(d.usernameLower))
            && getAfter(/databases/$(database)/documents/usernames/$(d.usernameLower)).data.uid == request.auth.uid);
    }

    match /users/{uid} {
      allow get: if true;
      allow list: if isAdmin();

      allow create: if isOwner(uid)
        && userKeysOk() && userValuesOk() && sellerProfileOk()
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.createdAt == request.time
        && usernameClaimedAfter();

      allow update: if isOwner(uid)
        && userKeysOk() && userValuesOk() && sellerProfileOk()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.role == resource.data.role
            || (resource.data.role == 'user' && request.resource.data.role == 'seller'))
        && (!('usernameLower' in resource.data)
            || request.resource.data.usernameLower == resource.data.usernameLower)
        && usernameClaimedAfter();

      allow delete: if isOwner(uid) || isAdmin();
    }

    function productFieldsOk() {
      let d = request.resource.data;
      return d.keys().hasOnly([
        'id', 'sellerId', 'sellerUsername', 'sellerBrandName', 'sellerAvatarUrl',
        'title', 'summary', 'description', 'category', 'platforms', 'techStack',
        'tags', 'features', 'previewUrl', 'coverImage', 'images', 'packages',
        'licenseType', 'demoAccessNote', 'status', 'searchTokens', 'apk',
        'rejectionReason', 'createdAt', 'updatedAt', 'publishedAt'
      ])
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 90
        && d.summary is string && d.summary.size() <= 200
        && d.description is string && d.description.size() <= 20000
        && d.category is string
        && d.platforms is list && d.platforms.size() <= 4
        && d.techStack is list && d.techStack.size() <= 20
        && d.tags is list && d.tags.size() <= 20
        && d.features is list && d.features.size() <= 30
        && d.images is list && d.images.size() <= 8
        && d.packages is list && d.packages.size() <= 3
        && d.searchTokens is list && d.searchTokens.size() <= 100
        && d.previewUrl is string
        && (d.previewUrl == '' || d.previewUrl.matches('^https://.*'))
        && d.licenseType in ['personal', 'commercial', 'both']
        && d.get('demoAccessNote', '') is string && d.get('demoAccessNote', '').size() <= 500
        && d.get('rejectionReason', '') is string && d.get('rejectionReason', '').size() <= 500;
    }

    match /products/{productId} {
      allow read: if resource == null
        || resource.data.status == 'published'
        || (isPermanent() && resource.data.sellerId == request.auth.uid)
        || isAdmin();

      allow create: if isPermanent() && isSeller()
        && productFieldsOk()
        && request.resource.data.id == productId
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status in ['draft', 'pending']
        && request.resource.data.get('publishedAt', null) == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (isPermanent()
            && resource.data.sellerId == request.auth.uid
            && request.resource.data.sellerId == resource.data.sellerId
            && productFieldsOk()
            && request.resource.data.status in ['draft', 'pending', 'unpublished']
            && request.resource.data.get('publishedAt', null) == resource.data.get('publishedAt', null)
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time)
        || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'publishedAt', 'rejectionReason', 'updatedAt'])
            && request.resource.data.status in ['published', 'rejected', 'pending', 'draft', 'unpublished']);

      allow delete: if isAdmin()
        || (isPermanent() && resource.data.sellerId == request.auth.uid);
    }

    match /reports/{reportId} {
      allow read: if isAdmin();

      allow create: if isSignedIn()
        && reportId == request.auth.uid + '_' + request.resource.data.productId
        && request.resource.data.keys().hasOnly(['id', 'reporterUid', 'productId', 'reason', 'details', 'createdAt', 'status'])
        && request.resource.data.id == reportId
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.reason in ['malware', 'copyright', 'misleading', 'spam', 'other']
        && request.resource.data.details is string && request.resource.data.details.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }

    match /follows/{followId} {
      allow read: if true;

      allow create: if isPermanent()
        && followId == request.auth.uid + '_' + request.resource.data.followingId
        && request.resource.data.keys().hasOnly(['followerId', 'followingId', 'createdAt'])
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow delete: if isPermanent()
        && resource.data.followerId == request.auth.uid;
    }

    match /likes/{likeId} {
      allow read: if true;

      allow create: if isPermanent()
        && likeId == request.auth.uid + '_' + request.resource.data.productId
        && request.resource.data.keys().hasOnly(['userId', 'productId', 'sellerId', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.sellerId is string
        && request.resource.data.createdAt == request.time;

      allow delete: if isPermanent()
        && resource.data.userId == request.auth.uid;
    }

    match /saves/{saveId} {
      allow read: if isPermanent() && resource.data.userId == request.auth.uid;

      allow create: if isPermanent()
        && saveId == request.auth.uid + '_' + request.resource.data.productId
        && request.resource.data.keys().hasOnly(['userId', 'productId', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.createdAt == request.time;

      allow delete: if isPermanent()
        && resource.data.userId == request.auth.uid;
    }
  }
}
